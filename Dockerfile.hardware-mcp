FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY pyproject.toml ./
COPY src ./src

# The Hardware MCP contains only the bounded simulator and recovery composition.
# Runtime approval state is read through the configured PostgreSQL connection.
RUN pip install --no-cache-dir \
        "mcp>=2.0,<3.0" \
        "opentelemetry-api>=1.44.0,<1.45" \
        "opentelemetry-exporter-otlp-proto-grpc>=1.44.0,<1.45" \
        "opentelemetry-instrumentation-asgi>=0.65b0,<0.66" \
        "opentelemetry-sdk>=1.44.0,<1.45" \
        "psycopg[binary]>=3.3.5,<3.4" \
        "sqlalchemy>=2.0.52,<2.1" \
        "uvicorn>=0.52.4,<0.53" \
    && pip install --no-cache-dir --no-deps .

USER app

EXPOSE 8006

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -m industrial_ai_agent.infrastructure.mcp_readiness --url http://127.0.0.1:8006/mcp --bearer-token-env MCP_INDUSTRIAL_AGENT_TOKEN --required-tool get_position_reference_status --required-tool prepare_reference_calibration --required-tool execute_reference_calibration

CMD ["python", "-m", "industrial_ai_agent.infrastructure.hardware_mcp_server", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8006"]
