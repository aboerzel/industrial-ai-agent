FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/home/app/.cache/huggingface

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgl1 libglib2.0-0 libxcb1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --create-home app

COPY pyproject.toml ./
COPY src ./src

# Share package version constraints with development; only the CPU wheel pair is
# deployment-specific. Constraints do not install unrelated Agent/API dependencies.
RUN python - <<'PY'
from pathlib import Path
import re
import tomllib

# pip constraints retain version bounds but cannot contain installation extras.
dependencies = [
    re.sub(r"\[[^\]]+\]", "", requirement)
    for requirement in tomllib.loads(Path("pyproject.toml").read_text())["project"]["dependencies"]
]
Path("/tmp/constraints.txt").write_text(
    "\n".join([*dependencies, "torch==2.7.1+cpu", "torchvision==0.22.1+cpu"]) + "\n"
)
PY

# Use CPU-only Torch wheels and persist RapidOCR weights in the external model cache.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        --constraint /tmp/constraints.txt \
        "torch==2.7.1+cpu" \
        "torchvision==0.22.1+cpu" \
    && pip install --no-cache-dir --constraint /tmp/constraints.txt \
        mcp langchain-core langchain-ollama docling numpy \
        opentelemetry-api opentelemetry-exporter-otlp-proto-grpc \
        opentelemetry-instrumentation-asgi opentelemetry-sdk \
        pydantic "psycopg[binary]" rapidocr sentence-transformers transformers \
        sqlalchemy uvicorn \
    && pip install --no-cache-dir --no-deps . \
    && rm -rf /usr/local/lib/python3.12/site-packages/rapidocr/models \
    && mkdir -p "$HF_HOME/rapidocr" \
    && ln -s "$HF_HOME/rapidocr" /usr/local/lib/python3.12/site-packages/rapidocr/models \
    && chown -R app:app /app /home/app

USER app

EXPOSE 8002

HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=3 \
    CMD python -m industrial_ai_agent.infrastructure.mcp_readiness --url http://127.0.0.1:8002/mcp --bearer-token-env MCP_INDUSTRIAL_AGENT_TOKEN --required-tool search_documentation

CMD ["python", "-m", "industrial_ai_agent.infrastructure.knowledge_mcp_server", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8002"]
