FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY pyproject.toml ./
COPY src ./src
COPY config ./config
COPY alembic.ini ./
COPY migrations ./migrations

RUN pip install --no-cache-dir \
        "alembic>=1.19.1,<1.20" \
        "fastapi>=0.141.1,<0.142" \
        "httpx>=0.28,<1.0" \
        "httpx2>=2.0,<3.0" \
        "langchain-core>=1.2,<2.0" \
        "langfuse>=4.15,<5.0" \
        "langgraph>=1.2,<2.0" \
        "langgraph-checkpoint-postgres>=3.1.2,<3.2" \
        "mcp>=2.0,<3.0" \
        "openai>=1.0,<3.0" \
        "opentelemetry-api>=1.44.0,<1.45" \
        "opentelemetry-exporter-otlp-proto-grpc>=1.44.0,<1.45" \
        "opentelemetry-instrumentation-asgi>=0.65b0,<0.66" \
        "opentelemetry-instrumentation-fastapi>=0.65b0,<0.66" \
        "opentelemetry-sdk>=1.44.0,<1.45" \
        "psycopg[binary]>=3.3.5,<3.4" \
        "python-dotenv>=1.0" \
        "sqlalchemy>=2.0.52,<2.1" \
        "uvicorn>=0.52.4,<0.53" \
    && pip install --no-cache-dir --no-deps .

USER app

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8000), 2).close()"

CMD ["python", "-m", "industrial_ai_agent.infrastructure.agent_api"]
