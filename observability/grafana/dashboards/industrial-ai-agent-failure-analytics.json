{
  "annotations": {"list": []},
  "editable": true,
  "description": "Observed failure history from bounded metrics and metadata-only logs. A failure location or count is not a root-cause conclusion.",
  "panels": [
    {"id": 1, "title": "Failed Agent Runs", "description": "Run-level failures during the selected time range. This is the only supported non-overlapping total failure measure.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(agent_errors_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO RUN DATA", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "title": "Agent Run Failure Rate", "description": "Failed agent runs divided by all completed agent runs during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(agent_errors_total[$__range])) / clamp_min(sum(increase(agent_runs_total[$__range])), 1)", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "noValue": "NO RUN DATA", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}},
    {"id": 3, "title": "Failed LLM Calls", "description": "Observed LLM call failures during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(llm_calls_total{operation_status=\"failure\"}[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO LLM DATA", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}},
    {"id": 4, "title": "Failed MCP Tool Operations", "description": "Observed MCP tool-operation failures during the selected time range. These boundaries can overlap a failed agent run.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(mcp_tool_calls_total{operation_status=\"failure\"}[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP DATA", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}},
    {"id": 5, "title": "Failed Agent Runs over Time", "description": "Rate of run-level failures. This does not identify a root cause.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(rate(agent_errors_total[$__rate_interval]))", "legendFormat": "failed runs", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO FAILURE DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}},
    {"id": 6, "title": "Observed Failed Boundaries over Time", "description": "LLM, MCP, and retrieval failure boundaries can overlap a single run. Treat as observed locations, not a deduplicated total or RCA.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(rate(llm_calls_total{operation_status=\"failure\"}[$__rate_interval]))", "legendFormat": "LLM", "refId": "A"}, {"expr": "sum(rate(mcp_tool_calls_total{operation_status=\"failure\"}[$__rate_interval]))", "legendFormat": "MCP tool", "refId": "B"}, {"expr": "sum(rate(retrieval_calls_total{operation_status=\"failure\"}[$__rate_interval]))", "legendFormat": "retrieval", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO FAILURE DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}},
    {"id": 7, "title": "Failed Agent Runs by Classification", "description": "Run-level failure distribution by bounded data classification. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (data_classification) (increase(agent_errors_total[$__range]))", "instant": true, "legendFormat": "{{data_classification}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO FAILURE DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 0, "y": 14}},
    {"id": 8, "title": "Failed LLM Calls by Model Profile", "description": "Observed LLM failure distribution by semantic model profile. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_profile) (increase(llm_calls_total{operation_status=\"failure\"}[$__range]))", "instant": true, "legendFormat": "{{model_profile}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO LLM FAILURE DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 8, "y": 14}},
    {"id": 9, "title": "Failed MCP Tool Operations by Tool", "description": "Observed MCP failure distribution by tool. Client and server operation boundaries can overlap; the selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (mcp_tool) (increase(mcp_tool_calls_total{operation_status=\"failure\"}[$__range]))", "instant": true, "legendFormat": "{{mcp_tool}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP FAILURE DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 16, "y": 14}},
    {"id": 10, "title": "Failed MCP Tool Operations by Emitting Service", "description": "Counts from the service that emitted the observed MCP failure. It identifies a failure location, never a root cause.", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (exported_job) (increase(mcp_tool_calls_total{operation_status=\"failure\"}[$__range]))", "instant": true, "legendFormat": "{{exported_job}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP FAILURE DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "orientation": "auto", "showValue": "auto", "stacking": "none", "tooltip": {"mode": "single", "sort": "none"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 0}, "gridPos": {"h": 9, "w": 12, "x": 0, "y": 23}},
    {"id": 11, "title": "Recent Failure Events", "description": "Sanitized Loki failure events: component, bounded event name, and sanitized error code only. They identify an observed location, not root cause.", "type": "logs", "datasource": {"uid": "loki"}, "targets": [{"expr": "{service_name=~\".+\"} | event_name=~\".*failed\" | line_format `{{.service_name}} | {{.event_name}} | {{.error_code}}`", "refId": "A"}], "options": {"dedupStrategy": "none", "enableLogDetails": false, "prettifyJSON": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}, "gridPos": {"h": 10, "w": 12, "x": 12, "y": 23}}
  ],
