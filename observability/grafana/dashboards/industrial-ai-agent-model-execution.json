{
  "annotations": {"list": []},
  "description": "Catalog-backed model execution overview. Stable model_id remains a telemetry label; legends use the catalog-derived display name.",
  "editable": true,
  "panels": [
    {"id": 1, "title": "Model Calls", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc(sum by (model_display_name) (increase(llm_calls_total[$__range])))", "instant": true, "legendFormat": "{{model_display_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO MODEL DATA"}, "overrides": []}, "options": {"orientation": "horizontal", "showValue": "always", "legend": {"displayMode": "hidden"}}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}},
    {"id": 2, "title": "Model Calls by Data Classification", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (data_classification) (increase(llm_calls_total[$__range]))", "instant": true, "legendFormat": "{{data_classification}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO MODEL DATA"}, "overrides": [{"matcher": {"id": "byName", "options": "PUBLIC"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]}, {"matcher": {"id": "byName", "options": "INTERNAL"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]}, {"matcher": {"id": "byName", "options": "CONFIDENTIAL"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]}, {"matcher": {"id": "byName", "options": "RESTRICTED"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]}]}, "options": {"pieType": "donut", "displayLabels": ["value"], "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}},
    {"id": 3, "title": "Model Calls by Execution Zone", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (execution_zone) (increase(llm_calls_total[$__range]))", "instant": true, "legendFormat": "{{execution_zone}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO MODEL DATA"}, "overrides": [{"matcher": {"id": "byName", "options": "LOCAL"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]}, {"matcher": {"id": "byName", "options": "PUBLIC_CLOUD"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]}]}, "options": {"pieType": "donut", "displayLabels": ["value"], "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}},
    {"id": 4, "title": "Input Tokens by Model", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc(sum by (model_display_name) (increase(llm_input_tokens_total[$__range])))", "instant": true, "legendFormat": "{{model_display_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO TOKEN DATA"}, "overrides": []}, "options": {"orientation": "horizontal", "showValue": "always", "legend": {"displayMode": "hidden"}}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"id": 5, "title": "Output Tokens by Model", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc(sum by (model_display_name) (increase(llm_output_tokens_total[$__range])))", "instant": true, "legendFormat": "{{model_display_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO TOKEN DATA"}, "overrides": []}, "options": {"orientation": "horizontal", "showValue": "always", "legend": {"displayMode": "hidden"}}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"id": 6, "title": "Average Model Duration", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc((sum by (model_display_name) (increase(llm_call_duration_seconds_sum[$__range])) / sum by (model_display_name) (increase(llm_call_duration_seconds_count[$__range])))", "instant": true, "legendFormat": "{{model_display_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "NO MODEL DATA"}, "overrides": []}, "options": {"orientation": "horizontal", "showValue": "always", "legend": {"displayMode": "hidden"}}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"id": 7, "title": "Model Decision Outcomes", "description": "Policy and configuration outcomes, not provider runtime failures.", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_decision_outcome) (increase(model_decisions_total{model_decision_outcome=~\"EXECUTED|EGRESS_DENIED|CAPABILITY_MISMATCH|MODEL_NOT_CONFIGURED\"}[$__range]))", "instant": true, "legendFormat": "{{model_decision_outcome}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO DECISION DATA"}, "overrides": [{"matcher": {"id": "byName", "options": "EXECUTED"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]}, {"matcher": {"id": "byName", "options": "EGRESS_DENIED"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]}, {"matcher": {"id": "byName", "options": "CAPABILITY_MISMATCH"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]}, {"matcher": {"id": "byName", "options": "MODEL_NOT_CONFIGURED"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]}]}, "options": {"orientation": "horizontal", "showValue": "always", "legend": {"displayMode": "hidden"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}},
    {"id": 8, "title": "Consumer Model Decisions", "type": "table", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_consumer_id, model_display_name, data_classification, model_decision_outcome) (increase(model_decisions_total[$__range]))", "instant": true, "legendFormat": "{{model_consumer_id}} / {{model_display_name}} / {{data_classification}} / {{model_decision_outcome}}", "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "NO DECISION DATA"}, "overrides": []}, "options": {"showHeader": true}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}},
    {"id": 9, "title": "Selection Mode and Policy", "description": "AUTO and MANUAL are configuration modes; policy is meaningful only for AUTO.", "type": "table", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_selection_mode, model_selection_policy, model_display_name) (increase(model_decisions_total[$__range]))", "instant": true, "legendFormat": "{{model_selection_mode}} / {{model_selection_policy}} / {{model_display_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "NO SELECTION DATA"}, "overrides": []}, "options": {"showHeader": true}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}},
    {"id": 10, "title": "Run-Level Execution Path", "description": "Enter a run ID to inspect the correlated OpenTelemetry hierarchy in Tempo. Trace spans retain run.id, trace_id, span_id, parent span relation, classification, tool/MCP metadata, and model decisions without protected payloads.", "type": "traces", "datasource": {"uid": "tempo"}, "targets": [{"queryType": "traceql", "query": "{ span.run.id = \"$run_id\" }", "refId": "A"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true}, "gridPos": {"h": 10, "w": 24, "x": 0, "y": 32}}
  ],
  "schemaVersion": 41,
  "tags": ["industrial-ai-agent", "models", "security", "tempo"],
  "templating": {"list": [{"name": "run_id", "label": "Run ID", "type": "textbox", "hide": 0, "current": {"selected": false, "text": "", "value": ""}, "options": []}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Industrial AI Agent - Model Execution",
  "uid": "industrial-ai-agent-model-execution",
  "version": 1
}
