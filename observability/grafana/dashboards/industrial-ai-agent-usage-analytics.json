    {"id":15,"title":"Average Tool Call Duration","description":"Average duration per individual tool call within the selected time range. Tools without calls in that range are omitted.","type":"barchart","datasource":{"uid":"prometheus"},"targets":[{"expr":"sort_desc((sum by (mcp_tool) (increase(mcp_tool_duration_seconds_sum[$__range])) / sum by (mcp_tool) (increase(mcp_tool_duration_seconds_count[$__range]))) and on (mcp_tool) (sum by (mcp_tool) (increase(mcp_tool_duration_seconds_count[$__range])) > 0))","instant":true,"range":false,"legendFormat":"{{mcp_tool}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s","decimals":2,"noValue":"NO TOOL DURATION DATA"},"overrides":[{"matcher":{"id":"byName","options":"Tool"},"properties":[{"id":"mappings","value":[{"type":"value","options":{"analyze_run":{"color":"#C15C17","text":"analyze_run"},"create_maintenance_ticket":{"color":"#FF7383","text":"create_maintenance_ticket"},"get_agent_run":{"color":"#8AB8FF","text":"get_agent_run"},"get_machine_status":{"color":"#73BF69","text":"get_machine_status"},"get_product_history":{"color":"#F2CC0C","text":"get_product_history"},"get_product_overview":{"color":"#70DBED","text":"get_product_overview"},"get_run_approval":{"color":"#FFB357","text":"get_run_approval"},"get_run_failure":{"color":"#E02F44","text":"get_run_failure"},"get_run_metrics":{"color":"#1F78C1","text":"get_run_metrics"},"get_run_tool_trajectory":{"color":"#A3BE8C","text":"get_run_tool_trajectory"},"get_run_trace":{"color":"#6ED0E0","text":"get_run_trace"},"get_service_health":{"color":"#508642","text":"get_service_health"},"get_station_overview":{"color":"#E24D42","text":"get_station_overview"},"get_trace_logs":{"color":"#CCA300","text":"get_trace_logs"},"investigate_run":{"color":"#BA43A9","text":"investigate_run"},"list_products":{"color":"#FF9830","text":"list_products"},"list_recent_agent_runs":{"color":"#B48EAD","text":"list_recent_agent_runs"},"list_stations":{"color":"#5794F2","text":"list_stations"},"run