{
  "annotations": {"list": []},
  "editable": true,
  "description": "Usage analysis from bounded Prometheus counters. Every donut uses the selected dashboard time range as its complete population.",
  "panels": [
    {"id": 1, "title": "Agent Runs", "description": "Completed agent runs during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(agent_runs_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO RUN DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "title": "LLM Calls", "description": "Instrumented LLM calls during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(llm_calls_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO LLM DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}},
    {"id": 3, "title": "MCP Tool Operations", "description": "Instrumented MCP client and server tool-operation boundaries, not deduplicated end-user requests.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(mcp_tool_calls_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}},
    {"id": 4, "title": "Retrieval Operations", "description": "Recorded API-side and Knowledge MCP retrieval boundaries during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(retrieval_calls_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO RETRIEVAL DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}},
    {"id": 5, "title": "Runs by Classification", "description": "Distribution of completed agent runs by bounded data classification. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (data_classification) (increase(agent_runs_total[$__range]))", "instant": true, "legendFormat": "{{data_classification}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO RUN DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 0, "y": 6}},
    {"id": 6, "title": "LLM Calls by Model Profile", "description": "Distribution by bounded semantic model profile. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_profile) (increase(llm_calls_total[$__range]))", "instant": true, "legendFormat": "{{model_profile}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO LLM DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 8, "y": 6}},
    {"id": 7, "title": "Tool Calls", "description": "Instrumented MCP tool-operation boundaries by tool during the selected time range. Client and server boundaries may both contribute.", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc(sum by (mcp_tool) (increase(mcp_tool_calls_total[$__range])))", "instant": true, "legendFormat": "{{mcp_tool}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "hidden", "placement": "bottom", "calcs": []}, "orientation": "horizontal", "showValue": "always", "stacking": "none", "tooltip": {"mode": "single", "sort": "desc"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 0}, "gridPos": {"h": 9, "w": 12, "x": 0, "y": 15}},
    {"id": 8, "title": "Agent-Initiated Tool Operations by MCP Service", "description": "Only client-side calls with the bounded mcp_server label are counted. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (mcp_server) (increase(mcp_tool_calls_total{mcp_server=~\".+\"}[$__range]))", "instant": true, "legendFormat": "{{mcp_server}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO AGENT MCP DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 16, "y": 6}},
    {"id": 9, "title": "LLM Calls by Provider and Model", "type": "text", "options": {"mode": "markdown", "content": "Provider and model are metadata-only Langfuse fields and are intentionally not Prometheus labels. Grafana has no Langfuse datasource in this stack, so this distribution is not shown rather than duplicating high-cardinality telemetry."}, "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24}},
    {"id": 10, "title": "Provider-Reported Token Usage", "type": "text", "options": {"mode": "markdown", "content": "Input, output, total-token and token-by-model/provider distributions are available only as metadata-only Langfuse observations when the provider reports them. They are not Prometheus metrics and cannot be safely aggregated in Grafana without a governed Langfuse datasource."}, "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24}},
    {"id": 11, "title": "Runs over Time", "description": "Completed agent runs per second.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(rate(agent_runs_total[$__rate_interval]))", "legendFormat": "runs", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO RUN DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30}},
    {"id": 12, "title": "LLM Calls over Time", "description": "Instrumented LLM calls per second by semantic model profile.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (model_profile) (rate(llm_calls_total[$__rate_interval]))", "legendFormat": "{{model_profile}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO LLM DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30}},
    {"id": 13, "title": "MCP Tool Operations over Time", "description": "Instrumented MCP tool-operation boundaries per second by tool.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (mcp_tool) (rate(mcp_tool_calls_total[$__rate_interval]))", "legendFormat": "{{mcp_tool}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO MCP DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38}},
    {"id": 14, "title": "Retrieval Activity over Time", "description": "Recorded retrieval boundaries per second by strategy.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (retrieval_strategy) (rate(retrieval_calls_total[$__rate_interval]))", "legendFormat": "{{retrieval_strategy}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO RETRIEVAL DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38}},
    {"id": 15, "title": "Average Tool Call Duration", "description": "Weighted average instrumented MCP tool-operation duration during the selected time range. Tools without calls in that range are omitted.", "type": "barchart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sort_desc((sum by (mcp_tool) (increase(mcp_tool_duration_seconds_sum[$__range])) / sum by (mcp_tool) (increase(mcp_tool_duration_seconds_count[$__range]))) and on (mcp_tool) (sum by (mcp_tool) (increase(mcp_tool_duration_seconds_count[$__range])) > 0))", "instant": true, "legendFormat": "{{mcp_tool}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "noValue": "NO TOOL DURATION DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "hidden", "placement": "bottom", "calcs": []}, "orientation": "horizontal", "showValue": "always", "stacking": "none", "tooltip": {"mode": "single", "sort": "desc"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 0}, "gridPos": {"h": 9, "w": 12, "x": 12, "y": 15}}
  ],
