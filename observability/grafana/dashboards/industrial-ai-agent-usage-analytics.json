    {"id": 3, "title": "MCP Tool Operations", "description": "Instrumented MCP client and server tool-operation boundaries, not deduplicated end-user requests.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(mcp_tool_calls_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO MCP DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}},
    {"id": 4, "title": "Retrieval Operations", "description": "Recorded API-side and Knowledge MCP retrieval boundaries during the selected time range.", "type": "stat", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(increase(retrieval_calls_total[$__range]))", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO RETRIEVAL DATA"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}},
