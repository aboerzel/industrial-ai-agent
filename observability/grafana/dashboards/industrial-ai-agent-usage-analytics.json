    {"id":7,"title":"Tool Calls","description":"Number of instrumented tool calls within the selected time range. Client and server boundaries may both contribute.","type":"barchart","datasource":{"uid":"prometheus"},"targets":[{"expr":"sort_desc(sum by (mcp_tool) (increase(mcp_tool_calls_total[$__range])) > 0)","instant":true,"range":false,"legendFormat":"{{mcp_tool}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","decimals":0,"noValue":"NO MCP DATA"},"overrides":[{"matcher":{"id":"byName","options":"Tool"},"properties":[{"id":"mappings","value":[{"type":"value","options":{"analyze_run":{"color":"#C15C17","text":"analyze_run"},"create_maintenance_ticket":{"color":"#FF7383","text":"create_maintenance_ticket"},"get_agent_run":{"color":"#8AB8FF","text":"get_agent_run"},"get_machine_status":{"color":"#73BF69","text":"get_machine_status"},"get_product_history":{"color":"#F2CC0C","text":"get_product_history"},"get_product_overview":{"color":"#70DBED","text":"get_product_overview"},"get_run_approval":{"color":"#FFB357","text":"get_run_approval"},"get_run_failure":{"color":"#E02F44","text":"get_run_failure"},"get_run_metrics":{"color":"#1F78C1","text":"get_run_metrics"},"get_run_tool_trajectory":{"color":"#A3BE8C","text":"get_run_tool_trajectory"},"get_run_trace":{"color":"#6ED0E0","text":"get_run_trace"},"get_service_health":{"color":"#508642","text":"get_service_health"},"get_station_overview":{"color":"#E24D42","text":"get_station_overview"},"get_trace_logs":{"color":"#CCA300","text":"get_trace_logs"},"investigate_run":{"color":"#BA43A9","text":"investigate_run"},"list_products":{"color":"#FF9830","text":"list_products"},"list_recent_agent_runs":{"color":"#B48EAD","text":"list_recent_agent_runs"},"list_stations":{"color":"#5794F2","text":"list_stations"},"runtime.approval.lookup":{"color":"#9E77ED","text":"runtime.approval.lookup"},"runtime.failure.lookup":{"color":"#F2495C","text":"runtime.failure.lookup"},"runtime.run.list":{"color":"#56D2B9","text":"runtime.run.list"},"runtime.run.lookup":{"color":"#A1C181","text":"runtime.run.lookup"},"runtime.trajectory.lookup":{"color":"#D683CE","text":"runtime.trajectory.lookup"},"search_documentation":{"color":"#B877D9","text":"search_documentation"}}}]}]}]},"options":{"orientation":"horizontal","xField":"Tool","colorByField":"Tool","stacking":"none","barRadius":0,"barWidth":0.95,"groupWidth":0.7,"showValue":"always","fullHighlight":true,"tooltip":{"mode":"single","sort":"desc","maxWidth":600},"legend":{"displayMode":"hidden","placement":"bottom","showLegend":false}},"gridPos":{"h":9,"w":12,"x":0,"y":15},"transformations":[{"id":"seriesToRows","options":{}},{"id":"organize","options":{"excludeByName":{"Time":true},"indexByName":{"Metric":0,"Value":1,"Time":2},"renameByName":{"Metric":"Tool","Value":"Calls"}}}]},
    {"id": 8, "title": "Agent-Initiated Tool Operations by MCP Service", "description": "Only client-side calls with the bounded mcp_server label are counted. The selected period is 100%.", "type": "piechart", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (mcp_server) (increase(mcp_tool_calls_total{mcp_server=~\".+\"}[$__range]))", "instant": true, "legendFormat": "{{mcp_server}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "NO AGENT MCP DATA"}, "overrides": []}, "options": {"pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 9, "w": 8, "x": 16, "y": 6}},
    {"id": 9, "title": "LLM Calls by Provider and Model", "type": "text", "options": {"mode": "markdown", "content": "Provider and model are metadata-only Langfuse fields and are intentionally not Prometheus labels. Grafana has no Langfuse datasource in this stack, so this distribution is not shown rather than duplicating high-cardinality telemetry."}, "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24}},
    {"id": 10, "title": "Provider-Reported Token Usage", "type": "text", "options": {"mode": "markdown", "content": "Input, output, total-token and token-by-model/provider distributions are available only as metadata-only Langfuse observations when the provider reports them. They are not Prometheus metrics and cannot be safely aggregated in Grafana without a governed Langfuse datasource."}, "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24}},
    {"id": 11, "title": "Runs over Time", "description": "Completed agent runs per second.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(rate(agent_runs_total[$__rate_interval]))", "legendFormat": "runs", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO RUN DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "none"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30}},
