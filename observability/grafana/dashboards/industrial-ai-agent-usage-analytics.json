    {"id": 13, "title": "MCP Tool Operations over Time", "description": "Instrumented MCP tool-operation boundaries per second by tool.", "type": "timeseries", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (mcp_tool) (rate(mcp_tool_calls_total[$__rate_interval]))", "legendFormat": "{{mcp_tool}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2, "noValue": "NO MCP DATA"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38}},
