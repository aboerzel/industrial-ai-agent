GROQ_API_KEY=replace-with-your-local-value
POSTGRES_ADMIN_PASSWORD=replace-with-local-demo-admin-password
POSTGRES_APP_PASSWORD=replace-with-local-demo-application-password
AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://factory_app:replace-with-local-demo-application-password@127.0.0.1:5432/factory_demo
MCP_INDUSTRIAL_AGENT_TOKEN=replace-with-local-industrial-agent-opaque-token
MCP_CODEX_DEVELOPMENT_TOKEN=replace-with-local-codex-development-opaque-token
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://127.0.0.1:3001
LANGFUSE_ENVIRONMENT=local
LANGFUSE_PUBLIC_KEY=replace-with-local-langfuse-project-public-key
LANGFUSE_SECRET_KEY=replace-with-local-langfuse-project-secret-key
LANGFUSE_POSTGRES_PASSWORD=replace-with-local-langfuse-postgres-password
LANGFUSE_SALT=replace-with-local-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-character-langfuse-encryption-key
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-local-langfuse-clickhouse-password
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-local-langfuse-minio-password
LANGFUSE_REDIS_AUTH=replace-with-local-langfuse-redis-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-local-langfuse-nextauth-secret
LANGFUSE_INIT_ORG_ID=replace-with-local-langfuse-organization-id
LANGFUSE_INIT_ORG_NAME=Industrial AI Agent Local
LANGFUSE_INIT_PROJECT_ID=replace-with-local-langfuse-project-id
LANGFUSE_INIT_PROJECT_NAME=Industrial AI Agent Local
